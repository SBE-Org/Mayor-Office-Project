# =====================================================================
# Production on Vercel + Neon + Supabase Storage
# Copy these into: Vercel -> Project -> Settings -> Environment Variables
# (and, for the one-time local setup in step 3 of the guide, into a local .env)
# Never commit real values.
# =====================================================================

# --- Database (Neon) -------------------------------------------------
# Neon dashboard -> Connect. Turn "Connection pooling" ON, copy the string. Host contains "-pooler".
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Same dialog with "Connection pooling" OFF. Host has NO "-pooler". Used for migrations only.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require"

# --- Uploaded documents (Supabase Storage, PRIVATE bucket) -----------
STORAGE_DRIVER="supabase"
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
# Supabase -> Project Settings -> API Keys -> secret key (or legacy service_role). Server-side only!
SUPABASE_SERVICE_KEY=""
SUPABASE_BUCKET="smo-documents"
# Vercel rejects request bodies over 4.5 MB, so keep uploads small on Vercel.
UPLOAD_MAX_MB="4"

# --- App -------------------------------------------------------------
DEMO_MODE="false"
TZ="Africa/Addis_Ababa"
SESSION_HOURS="8"
SESSION_IDLE_MINUTES="60"

# --- Scheduled reminders ---------------------------------------------
# Long random values (e.g. run: openssl rand -hex 32). Vercel Cron sends CRON_SECRET automatically.
CRON_SECRET=""
JOB_TOKEN=""

# --- Optional SMS / email gateways (leave empty to skip) -------------
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""
SMS_SENDER_ID=""
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_TOKEN=""
EMAIL_FROM=""
