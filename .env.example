# Copy to .env and adjust. Never commit .env.

# Local development uses SQLite. For production use PostgreSQL (see docs/DEPLOYMENT.md):
# DATABASE_URL="postgresql://user:password@localhost:5432/smo"
DATABASE_URL="file:./dev.db"

STORAGE_DIR="./storage"
TZ="Africa/Addis_Ababa"

# "true" seeds demo accounts/data and shows the demo banner. Use "false" in production.
DEMO_MODE="true"

SESSION_HOURS="8"
SESSION_IDLE_MINUTES="60"

# Bearer token for /api/v1/jobs/reminders (generate a long random value)
JOB_TOKEN=""

# Optional SMS / email gateways (leave empty to record messages as "skipped")
SMS_PROVIDER_URL=""
SMS_PROVIDER_TOKEN=""
SMS_SENDER_ID=""
EMAIL_WEBHOOK_URL=""
EMAIL_WEBHOOK_TOKEN=""
EMAIL_FROM=""

# Docker Compose only
POSTGRES_PASSWORD=""
